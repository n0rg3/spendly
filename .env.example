# Создайте .env на основе этого файла. Значения не добавляйте в Git.
BOT_TOKEN=

# Публичный HTTPS URL веб-приложения. Для локальной проверки используйте туннель.
MINI_APP_URL=

# Только для запуска Mini App в обычном браузере. Не добавляйте в production.
DEV_TELEGRAM_USER_ID=

# Gemini API для автокатегоризации позиций чеков (https://aistudio.google.com/apikey).
# Нужен локальному API (apps/api) и бессерверной функции apps/serverless.
# Для serverless ключ кладётся в env Vercel: cd apps/serverless && npx vercel env add GEMINI_API_KEY production
# Без ключа эндпоинт /api/receipts/parse вернёт позиции с category: null.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Разрешённые CORS-источники для API (через запятую), помимо дефолтных
# https://n0rg3.github.io и http://localhost:5173. Пример:
# CORS_ORIGINS=https://spendly-api.vercel.app
CORS_ORIGINS=