# Ключ Gemini API: распознавание чеков и автокатегоризация одним вызовом LLM
# (https://aistudio.google.com/apikey). Без ключа функция вернёт 503 — разбора без AI нет.
GEMINI_API_KEY=

# Модель Gemini (по умолчанию gemini-2.5-flash — поддерживает responseSchema/JSON Mode).
GEMINI_MODEL=gemini-2.5-flash

# Только для тестов: подмена базового URL Gemini (стаб/прокси). В production не задавать.
# GEMINI_BASE_URL=http://localhost:4999

# Дополнительные CORS-источники через запятую.
# По умолчанию разрешены https://n0rg3.github.io, http://localhost:5173, http://127.0.0.1:5173.
# ALLOWED_ORIGINS=https://spendly.example.com
ALLOWED_ORIGINS=