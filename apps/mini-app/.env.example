# Публичный HTTPS-адрес API (serverless-функция из apps/serverless, задеплоенная на Vercel).
# Клиент mini-app НИКОГДА не обращается к localhost на публичном домене.
#
# 1) cd apps/serverless && npx vercel --prod     -> получишь https://<project>.vercel.app
# 2) VITE_API_URL=https://<project>.vercel.app   (без слэша на конце)
# 3) pnpm --filter @sp3ndly/mini-app build
#
# Пусто = dev-режим: vite проксирует /api -> http://localhost:3001.
VITE_API_URL=